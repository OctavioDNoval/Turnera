# =========================================
# Turnera - Configuración de entorno
# Copiá este archivo a .env y ajustá valores
# =========================================

# --- Postgres ---
POSTGRES_DB=turnera
POSTGRES_USER=turnera
POSTGRES_PASSWORD=turnera_secret
POSTGRES_PORT=5432

# --- Backend ---
BACKEND_PORT=8080

# --- Backend / JWT y profesor inicial ---
# Secret para firmar JWT (¡cambialo! mínimo 32 caracteres)
TURNERA_JWT_SECRET=cambiar_por_un_secret_largo_y_aleatorio_123456
# Credenciales del profesor inicial (se crea automáticamente la primera vez)
TURNERA_ADMIN_USERNAME=profesor
TURNERA_ADMIN_PASSWORD=cambiar_password_profesor
# TURNERA_ADMIN_NAME=Profesor (opcional, default "Profesor")

# --- Frontend ---
FRONTEND_PORT=5173